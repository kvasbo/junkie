---
layout: none
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title }} – nye anmeldelser</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% if site.data.junkie.reviews.size > 0 %}{{ site.data.junkie.reviews[0].date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  {%- for r in site.data.junkie.reviews limit: 30 -%}
  {%- unless r.draft -%}
  <entry>
    <title>{{ r.title | xml_escape }} – {{ r.venue_title | xml_escape }} ({{ r.score }}/3)</title>
    <link href="{{ r.lenke | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ r.lenke | absolute_url }}</id>
    <published>{{ r.date | date_to_xmlschema }}</published>
    <updated>{{ r.date | date_to_xmlschema }}</updated>
    <author><name>{{ site.author | xml_escape }}</name></author>
    {%- for t in r.tags %}<category term="{{ t | xml_escape }}"/>{% endfor %}
    <summary>{{ r.excerpt | xml_escape }}</summary>
    <content type="html">{{ r.content | markdownify | xml_escape }}</content>
  </entry>
  {%- endunless -%}
  {%- endfor %}
</feed>
