#!/usr/bin/env bash
# Sjekker innholdet slik produksjonsbygget gjør: manglende bilder, ugyldig score,
# ukjente steder, dupliserte ankere, tags med ulik stavemåte, ukjente kategorier.
# Kjør før push. Feil gir feilkode 1 (og stopper Cloudflare-bygget), advarsler ikke.
set -uo pipefail
cd "$(dirname "$0")/.."
DEST="$(mktemp -d)"
trap 'rm -rf "$DEST"' EXIT
OUT="$(JEKYLL_ENV=production bundle exec jekyll build --destination "$DEST" 2>&1)"
STATUS=$?
echo "$OUT" | sed 's/\x1b\[[0-9;]*m//g' | grep -E "Junkie:" | sed 's/^ *Junkie: */  /' || true
if [ $STATUS -ne 0 ]; then
  echo; echo "FEIL – produksjonsbygget stopper. Rett opp og kjør igjen."
  exit 1
fi
N="$(echo "$OUT" | grep -c 'Junkie:')"
if [ "$N" -gt 0 ]; then
  echo; echo "OK med $N advarsler. Bygget går gjennom, men se over lista."
else
  echo "Alt i orden: $(find "$DEST" -name '*.html' | wc -l | tr -d ' ') sider bygget uten advarsler."
fi
