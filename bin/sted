#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Interaktiv veiviser for nytt sted (og valgfritt første anmeldelse).
#
#   bin/sted
#
# Spør om det viktigste, skriver _steder/<slug>.md med ren front matter,
# og kan lage _anmeldelser/<slug>-<rett>-<YYYY-MM>.md i samme slengen.
# Tomt svar = standardverdi i [klammer]. Ctrl-C avbryter uten å skrive noe.
#
# Med GOOGLE_MAPS_API_KEY satt (i miljøet eller i .env) spør veiviseren først
# om en delt Google Maps-lenke (eller place ID) og henter navn, adresse,
# koordinater, Maps-lenke og bydel derfra.
#
require "date"
require "fileutils"
require "json"
require "net/http"
require "uri"
require "yaml"

Encoding.default_external = Encoding::UTF_8
$stdin.set_encoding(Encoding::UTF_8)
$stdout.set_encoding(Encoding::UTF_8)

ROOT = File.expand_path("..", __dir__)

# KEY=verdi fra .env i rotmappa. Variabler som allerede er satt, vinner.
env_fil = File.join(ROOT, ".env")
File.foreach(env_fil) do |l|
  next unless (m = l.match(/\A\s*(?:export\s+)?([A-Za-z_]\w*)\s*=\s*(.*?)\s*\z/))
  ENV[m[1]] ||= m[2].sub(/\A(["'])(.*)\1\z/, '\2')
end if File.exist?(env_fil)
KATEGORIER = YAML.load_file(File.join(ROOT, "_data/kategorier.yml")) || []
BYDELER    = YAML.load_file(File.join(ROOT, "_data/bydeler.yml")) || []
GOOGLE_KEY = ENV["GOOGLE_MAPS_API_KEY"].to_s.strip
GOOGLE_URL = ENV.fetch("GOOGLE_PLACES_URL", "https://places.googleapis.com/v1")

def slugify(s)
  s.to_s.downcase.tr("æøå", "aoa").gsub(/[^a-z0-9]+/, "-").gsub(/\A-|-\z/, "")
end

def ask(label, default = nil, required: false)
  loop do
    prompt = default.to_s.empty? ? "#{label}: " : "#{label} [#{default}]: "
    print prompt
    line = $stdin.gets
    abort "\nAvbrutt." if line.nil?
    line = line.strip
    line = default.to_s if line.empty?
    return line unless required && line.empty?
    puts "  Må fylles ut."
  end
end

def ja?(label, default: false)
  svar = ask("#{label} (#{default ? 'J/n' : 'j/N'})", "").downcase
  return default if svar.empty?
  svar.start_with?("j", "y")
end

def ask_multiline(label)
  puts "#{label} (avslutt med en tom linje, eller trykk Enter med en gang for å hoppe over):"
  lines = []
  loop do
    line = $stdin.gets
    break if line.nil? || line.strip.empty?
    lines << line.rstrip
  end
  lines.join("\n")
end

# "59.912, 10.765" | "59.912 10.765" | Google Maps-URL med @lat,lng eller ?q=lat,lng
def parse_coords(str)
  m = str.match(/(-?\d{1,2}[.,]\d+)[\s,]+(-?\d{1,3}[.,]\d+)/)
  return nil unless m
  [m[1].tr(",", "."), m[2].tr(",", ".")].map { |x| x.to_f.round(6) }
end

# Kaller Places API (New). Returnerer JSON-svaret, eller nil (med melding) ved feil.
def google_api(req)
  uri = req.uri
  req["X-Goog-Api-Key"] = GOOGLE_KEY
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 10, read_timeout: 20) { |h| h.request(req) }
  data = JSON.parse(res.body)
  return data if res.code.to_i == 200
  puts "  Google svarte #{res.code}: #{data.dig('error', 'message') || res.body[0, 200]}"
  nil
end

# Finner place ID fra en Maps-lenke (delt maps.app.goo.gl-lenke eller
# google.com/maps/place/...). Lenken har navn, koordinater og stedets cid;
# vi søker på navnet nær koordinatene og velger treffet med samme cid.
def place_id_fra_lenke(url)
  5.times do
    break unless URI(url).host.to_s.end_with?("goo.gl")
    sted = Net::HTTP.get_response(URI(url))["location"] or break
    url = sted
  end
  return Regexp.last_match(1) if url =~ /[?&]query_place_id=([\w-]+)/

  navn = url[%r{/maps/place/([^/@?]+)}, 1]
  cid = url[/!1s0x\h+:0x(\h+)/, 1]&.to_i(16)
  lat, lng = (url.match(/!3d(-?[\d.]+)!4d(-?[\d.]+)/) || url.match(/@(-?[\d.]+),(-?[\d.]+)/))&.captures
  unless navn && cid
    puts "  Fant ikke stedet i lenken. Lim inn place ID i stedet."
    return nil
  end
  navn = URI.decode_www_form_component(navn)

  req = Net::HTTP::Post.new(URI("#{GOOGLE_URL}/places:searchText"))
  req["Content-Type"] = "application/json"
  req["X-Goog-FieldMask"] = "places.id,places.googleMapsUri"
  body = { textQuery: navn, languageCode: "no", regionCode: "NO", pageSize: 10 }
  body[:locationBias] = { circle: { center: { latitude: lat.to_f, longitude: lng.to_f }, radius: 500.0 } } if lat
  req.body = JSON.generate(body)
  treff = ((google_api(req) || {})["places"] || []).find { |p| p["googleMapsUri"].to_s[/[?&]cid=(\d+)/, 1].to_i == cid }
  puts "  Fant ikke «#{navn}» i Googles søk. Lim inn place ID i stedet." unless treff
  treff&.[]("id")
rescue StandardError => e
  puts "  Kunne ikke lese lenken: #{e.message}"
  nil
end

# Henter et sted fra Places API (New). Returnerer en hash med ferdige
# front matter-verdier, eller nil (med melding) hvis noe går galt.
def hent_google(place_id)
  req = Net::HTTP::Get.new(URI("#{GOOGLE_URL}/places/#{URI.encode_www_form_component(place_id)}?languageCode=no&regionCode=NO"))
  req["X-Goog-FieldMask"] = "id,displayName,formattedAddress,location,googleMapsUri,businessStatus,addressComponents"
  data = google_api(req) or return nil
  komponenter = (data["addressComponents"] || []).flat_map { |c| [c["longText"], c["shortText"]] }.compact
  bydel = BYDELER.find { |b| komponenter.any? { |k| k.casecmp?(b["name"].to_s) } }
  {
    "google_place_id" => data["id"],
    "name" => data.dig("displayName", "text"),
    "address" => data["formattedAddress"].to_s.sub(/,\s*(Norge|Norway)\z/, "").strip,
    "lat" => data.dig("location", "latitude")&.round(6),
    "lng" => data.dig("location", "longitude")&.round(6),
    "google_maps_url" => data["googleMapsUri"]&.sub(/&g_mp=[^&]*/, ""),
    "bydel" => bydel&.[]("slug"),
    "closed" => data["businessStatus"] == "CLOSED_PERMANENTLY"
  }
rescue StandardError => e
  puts "  Fikk ikke hentet fra Google: #{e.message}"
  nil
end

# Spør om delt Maps-lenke eller place ID til stedet er hentet, eller brukeren
# hopper over (tomt svar).
def ask_google(default = nil)
  return nil if GOOGLE_KEY.empty?
  loop do
    svar = ask("Delt Google Maps-lenke eller place ID (tomt = fyll inn for hånd)", default)
    return nil if svar.empty?
    lenke = svar[%r{https?://\S+}]
    id = lenke ? place_id_fra_lenke(lenke) : svar.delete_prefix("place_id:").strip
    g = id && hent_google(id)
    if g
      puts "  Fant: #{g['name']}, #{g['address']}#{g['closed'] ? ' (PERMANENT STENGT ifølge Google)' : ''}"
      return g
    end
    default = nil
  end
end

def pick_kategorier
  puts "Kategorier: " + KATEGORIER.map { |k| "#{k['slug']} (#{k['name']})" }.join(", ")
  loop do
    svar = ask("Kategorier, kommaseparert", KATEGORIER.first&.[]("slug"))
    valgt = svar.split(",").map { |s| s.strip }.reject(&:empty?).map do |s|
      hit = KATEGORIER.find { |k| k["slug"] == slugify(s) || k["name"].to_s.casecmp?(s) }
      hit ? hit["slug"] : slugify(s)
    end.uniq
    ukjente = valgt - KATEGORIER.map { |k| k["slug"] }
    unless ukjente.empty?
      puts "  Ukjent kategori: #{ukjente.join(', ')} (finnes ikke i _data/kategorier.yml)."
      next unless ja?("  Bruk likevel?", default: false)
    end
    return valgt unless valgt.empty?
  end
end

def pick_bydel(default = nil)
  svar = ask("Bydel/strøk (navn eller slug, tomt = ingen)", default)
  return nil if svar.empty?
  hit = BYDELER.find { |b| b["slug"] == slugify(svar) || b["name"].to_s.casecmp?(svar) }
  if hit
    hit["slug"]
  else
    puts "  «#{svar}» finnes ikke i _data/bydeler.yml – bruker slug «#{slugify(svar)}» (navnet blir slugen på siden)."
    slugify(svar)
  end
end

def ask_lokasjon(navn_paakrevd, g = nil)
  l = {}
  l["name"] = ask("Lokasjonens navn (f.eks. Kirkeristen)", nil, required: true) if navn_paakrevd
  if g
    l["address"] = ask("Adresse", g["address"], required: true)
    l["lat"], l["lng"] = g["lat"], g["lng"] if g["lat"]
    l["google_maps_url"] = g["google_maps_url"]
    l["google_place_id"] = g["google_place_id"]
    l["bydel"] = pick_bydel(g["bydel"])
    l["status"] = "closed" if navn_paakrevd && ja?("Er denne lokasjonen nedlagt?", default: g["closed"])
    return l
  end
  l["address"] = ask("Adresse", nil, required: true)
  loop do
    c = parse_coords(ask("Koordinater (lim inn «lat, lng» eller Google Maps-URL)", ""))
    if c
      l["lat"], l["lng"] = c
      break
    end
    break if ja?("  Fant ingen koordinater. Hopp over (ingen kartnål)?", default: false)
  end
  url = ask("Google Maps-lenke (valgfri)", "")
  l["google_maps_url"] = url unless url.empty?
  l["bydel"] = pick_bydel
  l["status"] = "closed" if navn_paakrevd && ja?("Er denne lokasjonen nedlagt?", default: false)
  l
end

def yaml_scalar(v)
  case v
  when nil then ""
  when Float, Integer then v.to_s
  else
    s = v.to_s
    s =~ /[:#\[\]{}&*!|>'"%@`,]|\A\s|\s\z/ || s.empty? ? s.inspect : s
  end
end

puts "== Nytt sted =="
puts "(Sett GOOGLE_MAPS_API_KEY for å hente stedsdata fra Google med place ID.)" if GOOGLE_KEY.empty?
google = ask_google
title = ask("Navn på stedet", google&.[]("name"), required: true)
slug  = ask("Slug (filnavn og URL)", slugify(title))
sted_path = File.join(ROOT, "_steder", "#{slug}.md")
abort "Finnes allerede: _steder/#{slug}.md" if File.exist?(sted_path)

categories = pick_kategorier

flere = ja?("Har stedet flere lokasjoner (kjede)?", default: false)
lokasjoner = []
if flere
  loop do
    puts "-- Lokasjon #{lokasjoner.size + 1} --"
    g = ask_google(lokasjoner.empty? ? google&.[]("google_place_id") : nil)
    lokasjoner << ask_lokasjon(true, g)
    break unless ja?("Legg til enda en lokasjon?", default: true)
  end
else
  lokasjoner << ask_lokasjon(false, google)
end

nedlagt = !flere && ja?("Er stedet nedlagt?", default: google&.[]("closed") || false)
closed_at = nedlagt ? ask("Når la det ned? (YYYY-MM)", Date.today.strftime("%Y-%m")) : nil
kommentar = ask_multiline("Redaksjonell kommentar om stedet (markdown)")

fm = +"---\n"
fm << "title: #{yaml_scalar(title)}\n"
fm << "categories: [#{categories.join(', ')}]\n"
if flere
  fm << "locations:\n"
  lokasjoner.each do |l|
    fm << "  - name: #{yaml_scalar(l['name'])}\n"
    fm << "    address: #{yaml_scalar(l['address'])}\n"
    fm << "    lat: #{l['lat']}\n    lng: #{l['lng']}\n" if l["lat"]
    fm << "    google_maps_url: #{l['google_maps_url']}\n" if l["google_maps_url"]
    fm << "    google_place_id: #{l['google_place_id']}\n" if l["google_place_id"]
    fm << "    bydel: #{l['bydel']}\n" if l["bydel"]
    fm << "    status: closed\n" if l["status"] == "closed"
  end
else
  l = lokasjoner.first
  fm << "bydel: #{l['bydel']}\n" if l["bydel"]
  fm << "address: #{yaml_scalar(l['address'])}\n"
  fm << "lat: #{l['lat']}\nlng: #{l['lng']}\n" if l["lat"]
  fm << "google_maps_url: #{l['google_maps_url']}\n" if l["google_maps_url"]
  fm << "google_place_id: #{l['google_place_id']}\n" if l["google_place_id"]
end
fm << "cover_image:\n"
fm << "score_override:\n"
fm << "status: #{nedlagt ? 'closed' : 'open'}\n"
fm << "closed_at: #{closed_at}\n" if closed_at
fm << "---\n"
fm << kommentar << "\n" unless kommentar.empty?

FileUtils.mkdir_p(File.dirname(sted_path))
File.write(sted_path, fm)
puts "\nSkrev _steder/#{slug}.md"

# --- valgfri første anmeldelse ------------------------------------------
if ja?("\nLage første anmeldelse nå?", default: true)
  puts "== Ny anmeldelse =="
  rett = ask("Rettens navn", nil, required: true)
  score = nil
  loop do
    s = ask("Score (0–3)", "0")
    if s =~ /\A[0-3]\z/
      score = s.to_i
      break
    end
    puts "  0, 1, 2 eller 3."
  end
  visited = ask("Besøkt (YYYY-MM)", Date.today.strftime("%Y-%m"))
  tags = ask("Tags, kommaseparert", categories.first).split(",").map(&:strip).reject(&:empty?)
  bilde = File.basename(ask("Bildefil i assets/img/anmeldelser/ (tomt = ingen)", ""))
  if !bilde.empty? && !File.exist?(File.join(ROOT, "assets/img/anmeldelser", bilde))
    puts "  Advarsel: assets/img/anmeldelser/#{bilde} finnes ikke (ennå)."
  end
  utkast = ja?("Lagre som utkast (ikke publiser ennå)?", default: false)
  publiser = !utkast
  body = ask_multiline("Anmeldelsen (markdown, 2–5 setninger)")

  key = "#{slug}-#{slugify(rett)}-#{visited}"
  anm_path = File.join(ROOT, "_anmeldelser", "#{key}.md")
  abort "Finnes allerede: _anmeldelser/#{key}.md" if File.exist?(anm_path)

  a = +"---\n"
  a << "venue: #{slug}\n"
  a << "title: #{yaml_scalar(rett)}\n"
  a << "score: #{score}\n"
  a << "visited: #{visited}\n"
  a << "date: #{Date.today}\n"
  a << "status: #{publiser ? 'published' : 'draft'}\n"
  a << "tags: [#{tags.join(', ')}]\n"
  a << "images:\n"
  if bilde.empty?
    a << "#  - src: /assets/img/anmeldelser/#{slug}-#{visited.delete('-')}.jpg\n"
    a << "#    alt: #{rett}\n"
  else
    a << "  - src: /assets/img/anmeldelser/#{bilde}\n"
    a << "    alt: #{yaml_scalar(rett)}\n"
  end
  a << "---\n"
  a << (body.empty? ? "Skriv anmeldelsen her.\n" : body + "\n")
  File.write(anm_path, a)
  puts "Skrev _anmeldelser/#{key}.md#{publiser ? '' : ' (utkast – sett status: published når den er klar)'}"
end

puts "\nSe resultatet med: bundle exec jekyll serve"
